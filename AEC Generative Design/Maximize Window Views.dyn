    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\n# Place your code below this line\r\npoint_list = []\r\n\r\nfor i in range(len(IN[0])):\r\n\tif IN[0][i] == True:\r\n\t\tpoint_list.append(IN[1][i])\r\n\telse:\r\n\t\tpoint_list.append(IN[2][i])\r\n\r\n# Assign your output to the OUT variable.\r\nOUT = point_list",
      "VariableInputPorts": true,
      "Id": "014220c265004847bd5f4fa98bba0768",
      "Inputs": [
        {
          "Id": "a742d4e78f604c3abc0c0fa1c429f121",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "61cd39c367c7458c9d89cc786d66881a",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "997b10f0cad344259de3f0394870581b",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "5a4c49cbf7694515ac049e7c02e15515",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded IronPython script."
    },
    {
